# Next.js Frontend .dockerignore

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local env files
.env*.local
.env

# Next.js build output (will be generated in container)
.next/
out/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Git
.git
.gitignore

# Documentation
README.md
*.md

# Docker files
Dockerfile*
docker-compose*.yml
.dockerignore

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
*.log

# Testing
coverage/
.nyc_output

# Misc
.cache
