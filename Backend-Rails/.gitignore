# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Ignore bundler config.
/.bundle

# Ignore gems installed locally
/vendor/bundle
/vendor/cache
/vendor/assets

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore uploaded files
/public/uploads
/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore database files
/*.sqlite3
/*.sqlite3-*

# Node modules (if using)
/node_modules
/yarn-error.log
/yarn.lock
/package-lock.json

# Cache files
/tmp/cache
/tmp/miniprofiler
/tmp/bootsnap*
/tmp/cache/bootsnap*

# IDE files
/.vscode
/.idea
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Deployment secrets
/.kamal/secrets

# RSpec
/coverage/

# Spring
/spring/*.pid

# Ignore application configuration
/config/application.yml
